# Anthropic API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Optional overrides
# LUMI_MODEL=claude-opus-5-5
# LUMI_EFFORT=low          # low | medium | high
# LUMI_RATE_LIMIT=60       # requests per IP per 10 minutes

# Natural voice (ElevenLabs). Without a key Lumi uses the device's own voice.
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=           # default voice; testers can switch it in Lumi's settings
# ELEVENLABS_MODEL=eleven_multilingual_v2   # or eleven_flash_v2_5 (faster), eleven_v3
# ELEVENLABS_SPEED=0.93
# ELEVENLABS_BASE_URL=           # optional, e.g. EU data residency endpoint
